{
  "name": "reader",
  "version": "1.0.0",
  "description": "Language-learning txt file reader",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "build": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.trizzy33.reader",
    "productName": "Reader",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
